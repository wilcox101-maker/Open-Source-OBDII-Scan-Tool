<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:ObdLink.App.Controls">

  <Style TargetType="Window"><Setter Property="Background" Value="{DynamicResource Bg}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Fg}"/></Style>
  <Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource Fg}"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="CaretBrush" Value="{DynamicResource Fg}"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="2"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="Margin" Value="3"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource Fg}"/></Style>
  <Style TargetType="GridSplitter"><Setter Property="Background" Value="{DynamicResource Border}"/></Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource Surface2}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/></Style>

  <Style TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Control}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="3"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="5" Effect="{DynamicResource RaisedShadow}">
            <ContentPresenter x:Name="P" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Pressed}"/><Setter TargetName="B" Property="Effect" Value="{x:Null}"/><Setter TargetName="P" Property="Margin" Value="0,1,0,-1"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource FgDisabled}"/><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Border}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ComboBox: fully templated so text stays readable (stock Aero template draws a light, disabled-looking box) -->
  <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
    <Border x:Name="B" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" Data="M0,0 L8,0 L4,5 Z" Fill="{DynamicResource Fg}"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="ComboBox">
    <Setter Property="Margin" Value="3"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="MinHeight" Value="24"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Template="{DynamicResource ComboToggle}" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter Margin="6,2,22,2" VerticalAlignment="Center" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                              TextElement.Foreground="{DynamicResource Fg}"/>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
              <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="Padding" Value="6,3"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="B" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/></Style>
  <Style TargetType="ListView"><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/></Style>
  <Style TargetType="ListViewItem">
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border x:Name="B" Background="Transparent"><GridViewRowPresenter Content="{TemplateBinding Content}"/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="{DynamicResource Control}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="4,2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridViewColumnHeader">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TabControl"><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Padding" Value="2"/></Style>
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource FgDim}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="B" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}" BorderThickness="1,1,1,0" Margin="0,0,2,0" Padding="12,5">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Selected}"/><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource SelFg}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource FgDisabled}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="RowBackground" Value="{DynamicResource Row}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource RowAlt}"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Border}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    <Setter Property="FontFamily" Value="Consolas"/>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Control}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="Padding" Value="6,3"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="0,0,1,1"/></Style>
  <Style TargetType="DataGridCell">
    <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/><Setter Property="Foreground" Value="{DynamicResource SelFg}"/><Setter Property="BorderBrush" Value="{DynamicResource Selected}"/></Trigger></Style.Triggers>
  </Style>

  <!-- ScrollBar -->
  <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="T" Background="{DynamicResource Thumb}" CornerRadius="3" Margin="2"/>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="{DynamicResource ThumbHover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ScrollPageStyle" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="{DynamicResource Panel}"/>
    <Setter Property="Width" Value="12"/><Setter Property="MinWidth" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Border Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Style="{DynamicResource ScrollPageStyle}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb Style="{DynamicResource ScrollThumbStyle}"/></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Style="{DynamicResource ScrollPageStyle}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="12"/><Setter Property="MinHeight" Value="12"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Border Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton><RepeatButton Style="{DynamicResource ScrollPageStyle}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                  <Track.Thumb><Thumb Style="{DynamicResource ScrollThumbStyle}"/></Track.Thumb>
                  <Track.IncreaseRepeatButton><RepeatButton Style="{DynamicResource ScrollPageStyle}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                </Track>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- v0.1.1 design system -->
  <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
  <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <CornerRadius x:Key="Radius">6</CornerRadius>
  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardGrad}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="6"/>
    <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
  </Style>
  <Style x:Key="PrimaryStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource DangerBg}"/><Setter Property="Foreground" Value="{DynamicResource DangerFg}"/><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style x:Key="ChipStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,2"/><Setter Property="Margin" Value="3"/>
    <Setter Property="Background" Value="{DynamicResource ChipIdle}"/>
  </Style>
  <Style x:Key="GlyphStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Icons}"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
  </Style>
  <Style TargetType="StatusBar"><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource FgDim}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="0,1,0,0"/></Style>
  <Style TargetType="StatusBarItem"><Setter Property="Foreground" Value="{DynamicResource FgDim}"/></Style>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="{DynamicResource Surface2}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/></Style>

  <!-- v0.2.0 menu bar: fully templated so the dropdowns follow Light/Dark -->
  <Style TargetType="Menu"><Setter Property="Background" Value="{DynamicResource MenuBg}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="Padding" Value="4,2"/></Style>
  <Style TargetType="Separator"><Setter Property="Background" Value="{DynamicResource Border}"/><Setter Property="Margin" Value="6,3"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{TemplateBinding Background}"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="Padding" Value="8,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="B" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition x:Name="IconCol" Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="GestureCol" Width="Auto"/><ColumnDefinition x:Name="ArrowCol" Width="14"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{DynamicResource Icons}" FontSize="12" Visibility="Collapsed" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
              <ContentPresenter x:Name="Icon" ContentSource="Icon" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource FgDim}"/>
              <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
              <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center"/>
              <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#xE76C;" FontFamily="{DynamicResource Icons}" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource FgDim}" Visibility="Collapsed"/>
              <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,8,8" Effect="{DynamicResource CardShadow}" MinWidth="200">
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </Border>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
              <Setter TargetName="IconCol" Property="Width" Value="0"/><Setter TargetName="GestureCol" Property="Width" Value="0"/><Setter TargetName="ArrowCol" Property="Width" Value="0"/>
              <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
              <Setter TargetName="IconCol" Property="Width" Value="0"/><Setter TargetName="GestureCol" Property="Width" Value="0"/><Setter TargetName="ArrowCol" Property="Width" Value="0"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/></Trigger>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource FgDisabled}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- v0.4.0 left rail: vertical ScrollViewer when short; icon-only (IsCompact) when tighter. Alt+number shortcuts are unchanged. -->
  <Style x:Key="NavTabControlStyle" TargetType="c:NavTabControl">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:NavTabControl">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource NavBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Effect="{DynamicResource RaisedShadow}" VerticalAlignment="Stretch">
              <ScrollViewer x:Name="PART_NavScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" VerticalAlignment="Stretch">
                <StackPanel IsItemsHost="True" Margin="6,8" Width="{Binding RailWidth, RelativeSource={RelativeSource TemplatedParent}}"/>
              </ScrollViewer>
            </Border>
            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" Margin="6,4,4,4"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NavTabStyle" TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource FgDim}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid Margin="0,2">
            <Border x:Name="B" Background="Transparent" CornerRadius="8" Padding="6,8">
              <StackPanel>
                <TextBlock x:Name="G" Text="{TemplateBinding Tag}" FontFamily="{DynamicResource Icons}" FontSize="20" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                <ContentPresenter x:Name="Label" ContentSource="Header" HorizontalAlignment="Center" Margin="0,4,0,0" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="11.5"/>
              </StackPanel>
            </Border>
            <Border x:Name="Bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,8" Background="{DynamicResource Accent}" Visibility="Hidden"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource NavSel}"/><Setter TargetName="Bar" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=c:NavTabControl}}" Value="True">
              <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
              <Setter Property="ToolTip" Value="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- v0.2.0 gauges (Controls/Gauges.cs) -->
  <Style TargetType="c:CircularGauge">
    <Setter Property="TrackBrush" Value="{DynamicResource GaugeTrack}"/><Setter Property="FillBrush" Value="{DynamicResource GaugeFill}"/><Setter Property="WarnBrush" Value="{DynamicResource GaugeCrit}"/>
    <Setter Property="NeedleBrush" Value="{DynamicResource GaugeNeedle}"/><Setter Property="TickBrush" Value="{DynamicResource GaugeTick}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="DimBrush" Value="{DynamicResource FgDim}"/>
  </Style>
  <Style TargetType="c:LinearGauge">
    <Setter Property="TrackBrush" Value="{DynamicResource GaugeTrack}"/><Setter Property="FillBrush" Value="{DynamicResource GaugeFill}"/><Setter Property="WarnBrush" Value="{DynamicResource GaugeWarn}"/>
    <Setter Property="NeedleBrush" Value="{DynamicResource GaugeNeedle}"/><Setter Property="TickBrush" Value="{DynamicResource GaugeTick}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="DimBrush" Value="{DynamicResource FgDim}"/>
  </Style>
  <!-- indicator lamp: Ellipse whose Fill is set by a DataTrigger in the view -->
  <Style x:Key="LampStyle" TargetType="Ellipse"><Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Fill" Value="{DynamicResource LampOff}"/><Setter Property="Stroke" Value="{DynamicResource LedRim}"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource FgDim}"/><Setter Property="Margin" Value="2,0,0,6"/></Style>
  <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="6,2,0,6"/></Style>
</ResourceDictionary>
