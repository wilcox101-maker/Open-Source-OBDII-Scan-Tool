<!-- Dark.xaml: palette only. Templates live in Controls.xaml and use DynamicResource, so ThemeManager can swap this dictionary live. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Bg" Color="#1B1C1F"/>
  <SolidColorBrush x:Key="Panel" Color="#24262A"/>
  <SolidColorBrush x:Key="Surface2" Color="#2C2F34"/>
  <SolidColorBrush x:Key="Field" Color="#1A1B1E"/>
  <SolidColorBrush x:Key="Control" Color="#33363C"/>
  <SolidColorBrush x:Key="Row" Color="#26282C"/>
  <SolidColorBrush x:Key="RowAlt" Color="#2A2C31"/>
  <SolidColorBrush x:Key="Fg" Color="#E6E6E6"/>
  <SolidColorBrush x:Key="FgDim" Color="#A4A8AE"/>
  <SolidColorBrush x:Key="FgDisabled" Color="#7C8087"/>
  <SolidColorBrush x:Key="Accent" Color="#4C8DF6"/>
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Border" Color="#3B3F46"/>
  <SolidColorBrush x:Key="Hover" Color="#3A3E45"/>
  <SolidColorBrush x:Key="Selected" Color="#1F4E8C"/>
  <SolidColorBrush x:Key="SelFg" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Thumb" Color="#4E535B"/>
  <SolidColorBrush x:Key="ThumbHover" Color="#6B717A"/>
  <SolidColorBrush x:Key="Danger" Color="#E5484D"/>
  <SolidColorBrush x:Key="DangerBg" Color="#4A1D20"/>
  <SolidColorBrush x:Key="DangerFg" Color="#FFD7D8"/>
  <SolidColorBrush x:Key="Warn" Color="#E0B050"/>
  <SolidColorBrush x:Key="Err" Color="#FF6B6B"/>
  <SolidColorBrush x:Key="Debug" Color="#9AA0A6"/>
  <SolidColorBrush x:Key="BannerBg" Color="#3A2A10"/>
  <SolidColorBrush x:Key="BannerBorder" Color="#E0B050"/>
  <SolidColorBrush x:Key="BannerFg" Color="#FFC56B"/>
  <SolidColorBrush x:Key="ChipIdle" Color="#3A3E45"/>
  <SolidColorBrush x:Key="ChipOk" Color="#1E5C3A"/>
  <SolidColorBrush x:Key="ChipBad" Color="#5C1E22"/>
  <SolidColorBrush x:Key="ChipWarn" Color="#5C4A1E"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1F4E8C"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1F4E8C"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#24262A"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E6E6E6"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#33363C"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E6E6E6"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#7C8087"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#2C2F34"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E6E6E6"/>
</ResourceDictionary>
