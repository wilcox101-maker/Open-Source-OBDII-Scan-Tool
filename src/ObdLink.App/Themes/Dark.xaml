<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Bg" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="Panel" Color="#252526"/>
  <SolidColorBrush x:Key="Fg" Color="#DDDDDD"/>
  <SolidColorBrush x:Key="Accent" Color="#3A7BD5"/>
  <SolidColorBrush x:Key="Border" Color="#3F3F46"/>
  <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource Bg}"/><Setter Property="Foreground" Value="{StaticResource Fg}"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Fg}"/></Style>
  <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource Fg}"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#1B1B1C"/><Setter Property="Foreground" Value="{StaticResource Fg}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="CaretBrush" Value="White"/><Setter Property="FontFamily" Value="Consolas"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#333337"/><Setter Property="Foreground" Value="{StaticResource Fg}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="3"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="3"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Foreground" Value="{StaticResource Fg}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="Black"/></Style>
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Foreground" Value="{StaticResource Fg}"/>
    <Setter Property="RowBackground" Value="#2A2A2D"/><Setter Property="AlternatingRowBackground" Value="#262628"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Border}"/>
    <Setter Property="FontFamily" Value="Consolas"/>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#333337"/><Setter Property="Foreground" Value="{StaticResource Fg}"/><Setter Property="Padding" Value="6,3"/></Style>
</ResourceDictionary>
