                         ToolTip="all | diag (700-7FF) | one ID (7E8, 18DAF110) | id/mask (700/780). Applied in the app; the adapter still receives everything."/>
                <Button Command="{Binding StartCommand}" Margin="0,0,4,0" IsEnabled="{Binding Idle}" ToolTip="Silent monitor (ATCSM1 + ATMA). Nothing is transmitted."><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE768;"/><TextBlock Text="Start"/></StackPanel></Button>
                <Button Command="{Binding StopCommand}" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE71A;"/><TextBlock Text="Stop"/></StackPanel></Button>
                <Button Command="{Binding RecordCommand}" Content="{Binding RecordText}" Margin="0,0,4,0" ToolTip="Write every kept frame to a CSV (time,id,ext,dlc,data) in the logs folder"/>
