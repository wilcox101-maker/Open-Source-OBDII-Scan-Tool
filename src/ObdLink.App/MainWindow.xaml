              <Button Command="{Binding OpenMotorcraftCommand}" ToolTip="Opens motorcraftservice.com/AsBuilt in your browser and copies the VIN to the clipboard. Ford requires sign-in and a captcha, so the app cannot download it for you."><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE774;"/><TextBlock Text="Get factory As-Built (Motorcraft)…"/></StackPanel></Button>
              <Button Command="{Binding ImportVehicleAbCommand}" ToolTip="Import the downloaded .ab; it is copied to Data\asbuilt and linked to this vehicle profile"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE8B5;"/><TextBlock Text="Import downloaded .ab…"/></StackPanel></Button>
            </WrapPanel>
            <TextBox Text="{Binding VehicleInfo, Mode=OneWay}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="{StaticResource Mono}"/>
          </DockPanel>
</Border>
        </TabItem>
        <TabItem Header="Console" Tag="&#xE756;">
          <Border Style="{StaticResource CardStyle}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Bottom">
              <CheckBox DockPanel.Dock="Right" Content="Allow writes" VerticalAlignment="Center" IsChecked="{Binding ConsoleAllowWrites}"/>
              <Button Command="{Binding ConsoleSendCommand}" Style="{StaticResource PrimaryStyle}" DockPanel.Dock="Right" IsDefault="True"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE724;"/><TextBlock Text="Send"/></StackPanel></Button>
              <TextBox ToolTip="Type help for the command list, cls to clear" Text="{Binding ConsoleInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}"/>
            </DockPanel>
            <TextBox Text="{Binding ConsoleOutput}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="{StaticResource Mono}"/>
          </DockPanel>
</Border>
        </TabItem>
        <TabItem Header="Logs" Tag="&#xE9D9;">
          <Border Style="{StaticResource CardStyle}">
            <TabControl x:Name="LogsPageTabs">
              <TabItem Header="Events"><ContentControl Content="{Binding EventsPanel}" ContentTemplate="{StaticResource LogPanelTemplate}"/></TabItem>
              <TabItem Header="Messages"><ContentControl Content="{Binding MessagesPanel}" ContentTemplate="{StaticResource LogPanelTemplate}"/></TabItem>
              <TabItem Header="Adapter traffic"><ContentControl Content="{Binding TrafficPanel}" ContentTemplate="{StaticResource LogPanelTemplate}"/></TabItem>
            </TabControl>
          </Border>
        </TabItem>
        <TabItem Header="Guide" Tag="&#xE897;">
          <Border Style="{StaticResource CardStyle}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Margin="6" TextWrapping="Wrap" Foreground="{DynamicResource FgDim}"
                         Text="Adapted from Livnitup's FORScan Tutorial (updated 6/14/26). Credit: Livnitup. Original: https://docs.google.com/document/d/1-8dKaS_Spu4Zw4hV_CrKC4tLoP9G8yejqegF1wxIqxY/"/>
              <FlowDocumentScrollViewer x:Name="GuideViewer" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/>
            </DockPanel>
          </Border>
        </TabItem>

        <TabItem Header="Settings" Tag="&#xE713;">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
              <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
              <TextBlock Margin="8,0,0,4" Foreground="{DynamicResource FgDim}" Text="{Binding DataDir, StringFormat=Changes are saved immediately to settings.json in {0}}"/>
              <WrapPanel>
                <Border Style="{StaticResource CardStyle}" Width="340">
                  <StackPanel>
                    <TextBlock Text="SAFETY" Style="{StaticResource SectionTitle}"/>
                    <CheckBox Content="Read-only test mode (recommended)" IsChecked="{Binding ReadOnlyTestMode}" FontWeight="SemiBold" ToolTip="Turning this OFF asks for confirmation first"/>
                    <TextBlock Text="{Binding ModeBanner}" Foreground="{DynamicResource BannerFg}" Margin="22,0,0,6" TextWrapping="Wrap"/>
                    <CheckBox Content="Redact VINs by default (logs, capture zip)" IsChecked="{Binding RedactVinsDefault}"/>
                    <CheckBox Content="Online VIN decode (NHTSA vPIC)" IsChecked="{Binding OnlineVinDecode}" ToolTip="Opt-in. Sends ONLY the VIN to vpic.nhtsa.dot.gov"/>
                    <CheckBox Content="Check GitHub for updates at startup" IsChecked="{Binding UpdateCheckEnabled}" ToolTip="Opt-in. One GET to api.github.com; nothing is downloaded"/>
                    <CheckBox Content="Check adapter firmware on connect" IsChecked="{Binding FirmwareCheckEnabled}" ToolTip="Reads STI on connect and asks OBDLink's public firmware feed for the latest stable version. Silent when offline. Skipped in DEMO. Never flashes anything."/>
                    <TextBlock Text="Firmware updater exe (optional override)" Margin="0,6,0,2"/>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseUpdaterPathCommand}" Margin="4,0,0,0"/>
                      <TextBox Text="{Binding FirmwareUpdaterPath, UpdateSourceTrigger=LostFocus}" ToolTip="Full path to StnFirmwareUpdater.exe. Empty = auto-detect (installed copy, then the one downloaded to Data\firmware\updater\)"/>
                    </DockPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="340">
                  <StackPanel>
                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionTitle}"/>
                    <DockPanel><TextBlock Text="Theme" Width="110" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"/></DockPanel>
                    <DockPanel><TextBlock Text="Header logo" Width="110" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding HeaderIcons}" SelectedItem="{Binding SelectedHeaderIcon}"/></DockPanel>
                    <DockPanel><TextBlock Text="Speed" Width="110" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding SpeedUnits}" SelectedItem="{Binding SpeedUnit}"/></DockPanel>
                    <DockPanel><TextBlock Text="Temperature" Width="110" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding TempUnits}" SelectedItem="{Binding TempUnit}"/></DockPanel>
                    <DockPanel><TextBlock Text="Pressure" Width="110" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding PressureUnits}" SelectedItem="{Binding PressureUnit}"/></DockPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="340">
                  <StackPanel>
                    <TextBlock Text="ADAPTER" Style="{StaticResource SectionTitle}"/>
                    <DockPanel><TextBlock Text="Default port" Width="110" VerticalAlignment="Center"/><TextBox Text="{Binding AdapterDefaultPort, UpdateSourceTrigger=LostFocus}" ToolTip="e.g. COM5; selected at startup if present"/></DockPanel>
                    <DockPanel><TextBlock Text="Adapter" Width="110" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding AdapterKinds}" SelectedItem="{Binding AdapterKind}"/></DockPanel>
                    <DockPanel><TextBlock Text="Timeout (ms)" Width="110" VerticalAlignment="Center"/><TextBox Text="{Binding AdapterTimeoutMs, UpdateSourceTrigger=LostFocus}"/></DockPanel>
                    <CheckBox Content="Show simulator ports (DEMO-MX+, DEMO-EX)" IsChecked="{Binding SimulatorEnabled}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="520">
                  <StackPanel>
                    <TextBlock Text="DASHBOARD" Style="{StaticResource SectionTitle}"/>
                    <DockPanel><TextBlock Text="Refresh (ms)" Width="110" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding RefreshRates}" SelectedItem="{Binding DashboardRefreshMs}" ToolTip="Base interval for RPM/speed/throttle; slower PIDs are polled less often and the rate backs off automatically on slow adapters"/></DockPanel>
                    <DockPanel><TextBlock Text="Low tire" Width="110" VerticalAlignment="Center"/><TextBox Width="60" Text="{Binding TpmsLowThreshold, UpdateSourceTrigger=LostFocus}" ToolTip="Low tire pressure warning, in the pressure unit above (default 30 psi / 207 kPa)"/><TextBlock Text="{Binding PressureUnit}" VerticalAlignment="Center" Margin="6,0"/></DockPanel>
                    <DockPanel Margin="0,4,0,2"><TextBlock Text="Background" Width="110" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Dashboard.BackgroundChoices}" SelectedValue="{Binding Dashboard.BackgroundId}" SelectedValuePath="Id" DisplayMemberPath="Name" ToolTip="Saved in Data\settings.json"/></DockPanel>
                    <Button Command="{Binding Dashboard.PickBackgroundCommand}" HorizontalAlignment="Left" ToolTip="Copies the picture into Data\backgrounds"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE8B9;"/><TextBlock Text="Pick dashboard image…"/></StackPanel></Button>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource FgDim}" Text="Dashboard items: use Customize on the Dashboard page (add / remove / reorder / display type / saved layouts). Gauge-height cards stack only when the window is narrower than a saved card."/>
                    <TextBlock Margin="110,0,0,4" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource FgDim}" Text="{Binding AvailableGaugeKeys, StringFormat=Available: {0}}"/>
                    <CheckBox Content="Ford enhanced PIDs (Mode 22). Tire pressure is verified; gear, trans temp and OSS stay UNVERIFIED." IsChecked="{Binding DashboardFordPids}"/>
                    <CheckBox Content="Estimate gear from RPM / speed when no gear DID answers" IsChecked="{Binding DashboardEstimateGear}"/>
                    <Button Command="{Binding Dashboard.OpenPidTableCommand}" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE70F;"/><TextBlock Text="Edit Ford PID table (JSON)…"/></StackPanel></Button>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="340">
                  <StackPanel>
                    <TextBlock Text="LOGS &amp; DATA" Style="{StaticResource SectionTitle}"/>
                    <DockPanel><TextBlock Text="Log level" Width="110" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevelSetting}" ToolTip="Applies on restart"/></DockPanel>
                    <DockPanel><TextBlock Text="Keep logs (days)" Width="110" VerticalAlignment="Center"/><TextBox Text="{Binding LogRetentionDays, UpdateSourceTrigger=LostFocus}"/></DockPanel>
                    <TextBlock Text="{Binding DataDirShort}" TextWrapping="Wrap" Margin="0,6" Foreground="{DynamicResource FgDim}" ToolTip="{Binding DataDirTooltip}"/>
                    <Button Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE838;"/><TextBlock Text="Open data folder"/></StackPanel></Button>
                  </StackPanel>
                </Border>
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </c:NavTabControl>
      <GridSplitter x:Name="LogSplitter" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows"/>
      <Border x:Name="LogPanel" Grid.Row="2" Style="{StaticResource CardStyle}" Padding="2" Margin="6,0,6,6">
        <TabControl SelectedValuePath="Header" SelectedValue="{Binding SelectedLogTab}">
          <TabItem Header="Events"><ContentControl Content="{Binding EventsPanel}" ContentTemplate="{StaticResource LogPanelTemplate}"/></TabItem>
          <TabItem Header="Messages"><ContentControl Content="{Binding MessagesPanel}" ContentTemplate="{StaticResource LogPanelTemplate}"/></TabItem>
          <TabItem Header="Adapter traffic"><ContentControl Content="{Binding TrafficPanel}" ContentTemplate="{StaticResource LogPanelTemplate}"/></TabItem>
        </TabControl>
      </Border>
    </Grid>
  </DockPanel>
</Window>
