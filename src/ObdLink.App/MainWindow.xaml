<Window x:Class="ObdLink.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ObdLink.App" xmlns:c="clr-namespace:ObdLink.App.Controls"
        Title="OBDLink EX / MX+ Diagnostics for Ford (open source)" Icon="pack://application:,,,/OBDLinkDiag;component/Assets/icon-3.ico" Height="860" Width="1360" MinWidth="1024" MinHeight="480">
  <Window.Resources>
    <DataTemplate x:Key="LogPanelTemplate" DataType="{x:Type local:LogPanelViewModel}">
      <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="2">
          <TextBlock Text="Level ≥" VerticalAlignment="Center" Margin="3"/>
          <ComboBox Width="110" ItemsSource="{Binding Levels}" SelectedItem="{Binding MinLevel}"/>
          <TextBlock Text="Search:" VerticalAlignment="Center" Margin="8,3,3,3"/>
          <TextBox Width="200" VerticalContentAlignment="Center" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}"/>
          <Button Command="{Binding ClearCommand}" ToolTip="Clear this view (files on disk are kept)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE894;"/><TextBlock Text="Clear"/></StackPanel></Button>
          <Button Content="Copy selected" Command="{Binding CopyCommand}" CommandParameter="{Binding SelectedItems, ElementName=LogList}"/>
          <Button Content="Export (.txt/.csv)…" Command="{Binding ExportCommand}"/>
          <CheckBox Content="Redact VINs on export/copy" IsChecked="{Binding RedactOnExport}" Margin="8,3"/>
          <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll}" Margin="8,3"/>
        </WrapPanel>
        <ListView x:Name="LogList" ItemsSource="{Binding Entries}" SelectionMode="Extended" FontFamily="{DynamicResource Mono}" FontSize="11"
                  local:AutoScroll.Enabled="{Binding AutoScroll}" VirtualizingPanel.IsVirtualizing="True">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Time" Width="95" DisplayMemberBinding="{Binding Time, StringFormat=HH:mm:ss.fff}"/>
              <GridViewColumn Header="Lvl" Width="40" DisplayMemberBinding="{Binding LevelText}"/>
              <GridViewColumn Header="Action / source" Width="210" DisplayMemberBinding="{Binding Action}"/>
              <GridViewColumn Header="Outcome" Width="80" DisplayMemberBinding="{Binding OutcomeText}"/>
              <GridViewColumn Header="Parameters" Width="220" DisplayMemberBinding="{Binding ParamText}"/>
              <GridViewColumn Header="Text / error" Width="560">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock x:Name="T" Text="{Binding DisplayText, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Error}"/>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Outcome}" Value="Failed"><Setter TargetName="T" Property="Text" Value="{Binding Error}"/></DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource Err}"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Debug"><Setter Property="Foreground" Value="{DynamicResource Debug}"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </ListView.ItemContainerStyle>
        </ListView>
      </DockPanel>
    </DataTemplate>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <!-- v0.2.1 layout-driven dashboard: bodies get a GaugeVm as DataContext -->
    <DataTemplate x:Key="DialBody" DataType="{x:Type local:GaugeVm}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" HorizontalAlignment="Center" Text="{Binding StatsText}" FontSize="10.5" Foreground="{DynamicResource FgDim}"/>
        <c:CircularGauge Title="{Binding Title}" Value="{Binding Value}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" WarnHigh="{Binding WarnHigh}" Unit="{Binding Unit}" ValueText="{Binding ValueText}"/>
      </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="BarBody" DataType="{x:Type local:GaugeVm}">
      <StackPanel>
        <c:LinearGauge Title="{Binding Title}" Value="{Binding Value}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" WarnHigh="{Binding WarnHigh}" WarnLow="{Binding WarnLow}" Unit="{Binding Unit}" ValueText="{Binding ValueText}"/>
        <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding HasSubtitle, Converter={StaticResource BoolVis}}"/>
        <TextBlock Text="{Binding StatsText}" FontSize="10.5" Foreground="{DynamicResource FgDim}" Margin="0,2,0,0"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="TileBody" DataType="{x:Type local:GaugeVm}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="Foot" DockPanel.Dock="Bottom" Text="{Binding TileFooter}" FontSize="10" Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock x:Name="V" Text="{Binding ValueText}" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
          <TextBlock Text="{Binding Unit}" Margin="6,0,0,6" VerticalAlignment="Bottom" Foreground="{DynamicResource FgDim}"/>
        </StackPanel>
      </DockPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsWarn}" Value="True"><Setter TargetName="V" Property="Foreground" Value="{DynamicResource GaugeCrit}"/></DataTrigger>
        <DataTrigger Binding="{Binding Unsupported}" Value="True"><Setter TargetName="V" Property="FontSize" Value="16"/><Setter TargetName="V" Property="Foreground" Value="{DynamicResource FgDim}"/></DataTrigger>
        <DataTrigger Binding="{Binding HasSubtitle}" Value="True"><Setter TargetName="Foot" Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="LampBody" DataType="{x:Type local:GaugeVm}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="L" Style="{StaticResource LampStyle}" Width="22" Height="22"/>
        <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Foreground="{DynamicResource FgDim}"><Run Text="{Binding ValueText, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Unit, Mode=OneWay}"/></TextBlock></StackPanel>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasValue}" Value="True"><Setter TargetName="L" Property="Fill" Value="{DynamicResource GaugeOk}"/></DataTrigger>
        <DataTrigger Binding="{Binding IsWarn}" Value="True"><Setter TargetName="L" Property="Fill" Value="{DynamicResource GaugeCrit}"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="TireBox" DataType="{x:Type local:GaugeVm}">
      <Border x:Name="B" Width="74" Height="52" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource GaugeOk}" Background="{DynamicResource Field}" ToolTip="{Binding Note}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock x:Name="V" Text="{Binding ValueText}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding Unit}" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasValue}" Value="False"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource FgDim}"/></DataTrigger>
        <DataTrigger Binding="{Binding IsLow}" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource GaugeCrit}"/><Setter TargetName="V" Property="Foreground" Value="{DynamicResource GaugeCrit}"/></DataTrigger>
        <DataTrigger Binding="{Binding Unsupported}" Value="True"><Setter TargetName="V" Property="FontSize" Value="10"/><Setter TargetName="V" Property="Foreground" Value="{DynamicResource FgDim}"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="TpmsBody" DataType="{x:Type local:TpmsVm}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="TIRE PRESSURES" Style="{StaticResource SectionTitle}"/>
        <Grid HorizontalAlignment="Center" Margin="0,4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <!-- truck body seen from above, front at the top -->
          <Border Grid.Column="1" Grid.RowSpan="3" Margin="6,0" CornerRadius="22,22,8,8" BorderThickness="2" BorderBrush="{DynamicResource FgDim}" Background="{DynamicResource Bg}">
            <TextBlock Text="FRONT" FontSize="9" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource FgDim}"/>
          </Border>
          <StackPanel Grid.Column="0" Grid.Row="0"><TextBlock Text="LF" FontSize="10" Foreground="{DynamicResource FgDim}"/><ContentControl Content="{Binding LF}" ContentTemplate="{StaticResource TireBox}"/></StackPanel>
          <StackPanel Grid.Column="2" Grid.Row="0"><TextBlock Text="RF" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource FgDim}"/><ContentControl Content="{Binding RF}" ContentTemplate="{StaticResource TireBox}"/></StackPanel>
          <StackPanel Grid.Column="0" Grid.Row="2"><TextBlock Text="LR" FontSize="10" Foreground="{DynamicResource FgDim}"/><ContentControl Content="{Binding LR}" ContentTemplate="{StaticResource TireBox}"/></StackPanel>
          <StackPanel Grid.Column="2" Grid.Row="2"><TextBlock Text="RR" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource FgDim}"/><ContentControl Content="{Binding RR}" ContentTemplate="{StaticResource TireBox}"/></StackPanel>
        </Grid>
      </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="DashItemCard" DataType="{x:Type local:DashItemVm}">
      <!-- Width stays on FlowWidth (v0.4.0): saved size, or the stacked width when the window is narrower than the widest card. Height is on BodySlot so the Move toolbar is not clipped. -->
      <Border x:Name="Card" Style="{StaticResource CardStyle}" Width="{Binding FlowWidth}" ToolTip="{Binding Gauge.Note}" AllowDrop="True"
              Focusable="True" KeyboardNavigation.IsTabStop="False" AutomationProperties.Name="{Binding Title}"
              PreviewMouseLeftButtonDown="DashItem_MouseDown" PreviewMouseMove="DashItem_MouseMove" Drop="DashItem_Drop" DragOver="DashItem_DragOver" PreviewKeyDown="DashItem_KeyDown">
        <!-- DropOverlay sits on top of the gauge. WPF only drop-targets the element actually under the pointer,
             and that element must have AllowDrop itself (parents are ignored). The overlay is invisible to the
             mouse until a drag starts, so the Move buttons still click. -->
        <Grid>
          <DockPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4" Visibility="{Binding DataContext.Customizing, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolVis}}">
              <Border Cursor="SizeAll" Padding="8,3" Margin="3" CornerRadius="4" Background="{DynamicResource Control}" ToolTip="Drag this card onto another card">
                <TextBlock Text="Drag" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </Border>
              <Button Content="Move left" ToolTip="{Binding MoveHint}" AutomationProperties.Name="Move left" Command="{Binding MoveLeftCommand}"/>
              <Button Content="Move right" ToolTip="{Binding MoveHint}" AutomationProperties.Name="Move right" Command="{Binding MoveRightCommand}"/>
              <Button Content="Move up" ToolTip="Move this card up one row" AutomationProperties.Name="Move up" Tag="Up" Click="DashItemRow_Click"/>
              <Button Content="Move down" ToolTip="Move this card down one row" AutomationProperties.Name="Move down" Tag="Down" Click="DashItemRow_Click"/>
              <ComboBox MinWidth="70" ItemsSource="{Binding Displays}" SelectedItem="{Binding Display}" IsEnabled="{Binding CanChangeDisplay}" ToolTip="Display type"/>
              <ComboBox MinWidth="70" ItemsSource="{Binding Sizes}" SelectedItem="{Binding Size}" ToolTip="Size: Small, Medium, Large, Wide (two columns)" AutomationProperties.Name="Size"/>
              <Button Content="Remove" ToolTip="Remove from this layout" AutomationProperties.Name="Remove" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
            </WrapPanel>
            <Border x:Name="BodySlot" Height="120">
              <ContentControl x:Name="Body" Content="{Binding Gauge}" ContentTemplate="{StaticResource BarBody}"/>
            </Border>
          </DockPanel>
          <Border x:Name="DropOverlay" Tag="DropOverlay" AllowDrop="True" Background="Transparent" IsHitTestVisible="False" Drop="DashItem_Drop" DragOver="DashItem_DragOver"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Display}" Value="Dial"><Setter TargetName="Body" Property="ContentTemplate" Value="{StaticResource DialBody}"/><Setter TargetName="BodySlot" Property="Height" Value="250"/></DataTrigger>
        <DataTrigger Binding="{Binding Display}" Value="Tile"><Setter TargetName="Body" Property="ContentTemplate" Value="{StaticResource TileBody}"/><Setter TargetName="BodySlot" Property="Height" Value="130"/></DataTrigger>
        <DataTrigger Binding="{Binding Display}" Value="Lamp"><Setter TargetName="Body" Property="ContentTemplate" Value="{StaticResource LampBody}"/><Setter TargetName="BodySlot" Property="Height" Value="80"/></DataTrigger>
        <DataTrigger Binding="{Binding Display}" Value="Tpms"><Setter TargetName="Body" Property="Content" Value="{Binding Tpms}"/><Setter TargetName="Body" Property="ContentTemplate" Value="{StaticResource TpmsBody}"/><Setter TargetName="BodySlot" Property="Height" Value="290"/></DataTrigger>
        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsLarge}" Value="True"/><Condition Binding="{Binding Display}" Value="Dial"/></MultiDataTrigger.Conditions><Setter TargetName="BodySlot" Property="Height" Value="310"/></MultiDataTrigger>
        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsLarge}" Value="True"/><Condition Binding="{Binding Display}" Value="Tile"/></MultiDataTrigger.Conditions><Setter TargetName="BodySlot" Property="Height" Value="180"/></MultiDataTrigger>
        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsLarge}" Value="True"/><Condition Binding="{Binding Display}" Value="Tpms"/></MultiDataTrigger.Conditions><Setter TargetName="BodySlot" Property="Height" Value="320"/></MultiDataTrigger>
        <DataTrigger Binding="{Binding Size}" Value="Medium"><Setter TargetName="Card" Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="1.2" ScaleY="1.2"/></Setter.Value></Setter></DataTrigger>
        <DataTrigger Binding="{Binding DataContext.Customizing, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
          <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
          <Setter TargetName="Card" Property="Cursor" Value="SizeAll"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- a dashboard bar card: LinearGauge + min/max/avg -->
    <DataTemplate x:Key="BarCard" DataType="{x:Type local:GaugeVm}">
      <Border Style="{StaticResource CardStyle}" Width="300" ToolTip="{Binding Note}">
        <StackPanel>
          <c:LinearGauge Title="{Binding Title}" Value="{Binding Value}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" WarnHigh="{Binding WarnHigh}" WarnLow="{Binding WarnLow}" Unit="{Binding Unit}" ValueText="{Binding ValueText}"/>
          <TextBlock Text="{Binding StatsText}" FontSize="10.5" Foreground="{DynamicResource FgDim}" Margin="0,2,0,0"/>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="DialCard" DataType="{x:Type local:GaugeVm}">
      <Border Style="{StaticResource CardStyle}" Width="280" Height="300" ToolTip="{Binding Note}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Bottom" HorizontalAlignment="Center" Text="{Binding StatsText}" FontSize="10.5" Foreground="{DynamicResource FgDim}"/>
          <c:CircularGauge Title="{Binding Title}" Value="{Binding Value}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" WarnHigh="{Binding WarnHigh}" Unit="{Binding Unit}" ValueText="{Binding ValueText}"/>
        </DockPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Window.InputBindings>
    <!-- v0.3.0: all shortcuts are handled in MainWindow.OnShortcutKey from ObdLink.Core.Ui.Shortcuts -->
  </Window.InputBindings>
  <DockPanel x:Name="RootPanel">
    <Menu DockPanel.Dock="Top" x:Name="MainMenu">
      <MenuItem Header="_File">
        <MenuItem Header="_Open factory .ab…" InputGestureText="Ctrl+O" Command="{Binding ImportFactoryAbCommand}"/>
        <MenuItem Header="Open FORScan ._abt…" Command="{Binding ImportAbtCommand}"/>
        <MenuItem Header="_Export">
          <MenuItem Header="_Factory .ab (optionally redacted)…" InputGestureText="Ctrl+S" Command="{Binding ExportFactoryAbCommand}"/>
          <MenuItem Header="FORScan .abt…" Command="{Binding ExportAbtCommand}"/>
          <MenuItem Header="E_vents log…" InputGestureText="Ctrl+E" Command="{Binding EventsPanel.ExportCommand}"/>
          <MenuItem Header="Messages log…" Command="{Binding MessagesPanel.ExportCommand}"/>
          <MenuItem Header="Adapter traffic log…" Command="{Binding TrafficPanel.ExportCommand}"/>
        </MenuItem>
        <MenuItem Header="_Save diagnostics capture (zip)" InputGestureText="Ctrl+Alt+C" Command="{Binding DiagnosticsCaptureCommand}"/>
        <MenuItem Header="Open _data folder" Command="{Binding OpenDataFolderCommand}"/>
        <Separator/>
        <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Copy" Command="ApplicationCommands.Copy"/>
        <MenuItem Header="Select _all" Command="ApplicationCommands.SelectAll"/>
        <Separator/>
        <MenuItem Header="_Find in logs…" InputGestureText="Ctrl+F" Click="FindLogs_Click"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Theme">
          <MenuItem Header="Light" Click="Theme_Click" Tag="Light"/>
          <MenuItem Header="Dark" Click="Theme_Click" Tag="Dark"/>
          <MenuItem Header="System" Click="Theme_Click" Tag="System"/>
        </MenuItem>
        <MenuItem x:Name="LogPanelMenu" Header="Log _panel" IsCheckable="True" IsChecked="True" InputGestureText="Ctrl+L" Click="LogPanel_Click"/>
        <Separator/>
        <MenuItem Header="Zoom _in" InputGestureText="Ctrl++" Click="ZoomIn_Click"/>
        <MenuItem Header="Zoom _out" InputGestureText="Ctrl+-" Click="ZoomOut_Click"/>
        <MenuItem Header="_Reset zoom" InputGestureText="Ctrl+0" Click="ZoomReset_Click"/>
        <MenuItem Header="_Full screen" InputGestureText="F11" Click="FullScreen_Click"/>
      </MenuItem>
      <MenuItem Header="V_ehicle">
        <MenuItem Header="_Connect" InputGestureText="F5" Command="{Binding ConnectCommand}"/>
        <MenuItem Header="_Disconnect" InputGestureText="Shift+F5" Command="{Binding DisconnectCommand}"/>
        <Separator/>
        <MenuItem Header="_Identify vehicle" InputGestureText="Ctrl+I" Command="{Binding IdentifyVehicleCommand}" FontWeight="SemiBold"/>
        <MenuItem Header="_Scan modules" InputGestureText="Ctrl+M" Command="{Binding ScanCommand}"/>
        <MenuItem Header="Read OBD-II _DTCs" InputGestureText="Ctrl+D" Command="{Binding ReadObdDtcsCommand}"/>
        <MenuItem Header="Read DTCs from _all modules" InputGestureText="Ctrl+Shift+D" Command="{Binding ReadAllModuleDtcsCommand}"/>
        <MenuItem Header="C_lear DTCs (selected module)…" InputGestureText="Ctrl+Shift+Delete" Command="{Binding ClearModuleDtcsCommand}"/>
        <Separator/>
        <MenuItem Header="Read _As-Built (selected module)" InputGestureText="Ctrl+R" Command="{Binding ReadAsBuiltCommand}"/>
        <MenuItem Header="Read all _modules (backup)" InputGestureText="Ctrl+Shift+R" Command="{Binding ReadAllModulesAsBuiltCommand}"/>
        <MenuItem Header="_Backup As-Built" InputGestureText="Ctrl+B" Command="{Binding BackupAsBuiltCommand}"/>
        <MenuItem Header="_Write + verify As-Built…" InputGestureText="Ctrl+W" Command="{Binding WriteAsBuiltCommand}"/>
        <MenuItem Header="Read _VIN" Command="{Binding ReadVinCommand}"/>
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="_Dashboard" InputGestureText="Alt+1" Click="Nav_Click" Tag="Dashboard"/>
        <MenuItem Header="Raw _console" InputGestureText="Ctrl+`" Click="Nav_Click" Tag="Console"/>
        <MenuItem Header="Diagnostics _capture" InputGestureText="Ctrl+Alt+C" Command="{Binding DiagnosticsCaptureCommand}"/>
        <MenuItem Header="Discovery _sweep (UNVERIFIED IDs)" Command="{Binding DiscoveryCommand}"/>
        <MenuItem Header="Adapter _firmware">
          <MenuItem Header="Check adapter _firmware" InputGestureText="Ctrl+Alt+F" Command="{Binding CheckFirmwareCommand}"/>
          <MenuItem Header="_Get official updater" Command="{Binding GetUpdaterCommand}" ToolTip="Downloads OBDLink's official STN Firmware Update Utility from scantool.net into Data\firmware\updater\ and checks it"/>
          <MenuItem Header="_Run official updater…" Command="{Binding RunUpdaterCommand}" ToolTip="Disconnects the adapter and starts OBDLink's official updater (UAC prompt)"/>
          <MenuItem Header="Open firmware _folder" Command="{Binding OpenFirmwareFolderCommand}"/>
          <MenuItem Header="Official updater _page" Command="{Binding OpenFirmwarePageCommand}"/>
        </MenuItem>
        <MenuItem Header="Pause / resume dashboard" InputGestureText="Ctrl+P" Command="{Binding Dashboard.PauseCommand}"/>
        <MenuItem Header="Record dashboard CSV" InputGestureText="Ctrl+Shift+P" Command="{Binding Dashboard.RecordCommand}"/>
        <MenuItem Header="_Edit Ford enhanced PID table (JSON)…" Command="{Binding Dashboard.OpenPidTableCommand}"/>
      </MenuItem>
      <MenuItem Header="_Settings" Click="Nav_Click" Tag="Settings" ToolTip="Settings (Ctrl+,)"/>
      <MenuItem Header="_Help">
        <MenuItem Header="_Guide" InputGestureText="F1" Click="Nav_Click" Tag="Guide"/>
        <MenuItem Header="_Keyboard shortcuts" InputGestureText="Shift+F1" Click="Shortcuts_Click"/>
        <MenuItem Header="Console _commands" Click="ConsoleHelp_Click"/>
        <MenuItem Header="Check for _updates…" Command="{Binding CheckUpdatesCommand}"/>
        <MenuItem Header="GitHub _project page" Click="GitHub_Click"/>
        <Separator/>
        <MenuItem Header="_About" Click="About_Click"/>
      </MenuItem>
    </Menu>

    <!-- Slim header: connection essentials + LEDs -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderGrad}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="10,6" Effect="{DynamicResource RaisedShadow}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Margin="3,0" ToolTip="Connection: lit while connected">
            <Ellipse Width="11" Height="11" StrokeThickness="1" Stroke="{DynamicResource LedRim}" VerticalAlignment="Center">
              <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource LedOff}"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="{DynamicResource LedConn}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
            </Ellipse>
            <TextBlock Text="LINK" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="3,0" ToolTip="TX: a command was sent to the adapter">
            <Ellipse Width="11" Height="11" StrokeThickness="1" Stroke="{DynamicResource LedRim}" VerticalAlignment="Center">
              <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource LedOff}"/>
                <Style.Triggers><DataTrigger Binding="{Binding TxOn}" Value="True"><Setter Property="Fill" Value="{DynamicResource LedTx}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
            </Ellipse>
            <TextBlock Text="TX" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="3,0" ToolTip="RX: a reply arrived from the adapter">
            <Ellipse Width="11" Height="11" StrokeThickness="1" Stroke="{DynamicResource LedRim}" VerticalAlignment="Center">
              <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource LedOff}"/>
                <Style.Triggers><DataTrigger Binding="{Binding RxOn}" Value="True"><Setter Property="Fill" Value="{DynamicResource LedRx}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
            </Ellipse>
            <TextBlock Text="RX" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="3,0" ToolTip="Error: timeout, NO DATA, ?, adapter error or a negative response (7F xx NRC)">
            <Ellipse Width="11" Height="11" StrokeThickness="1" Stroke="{DynamicResource LedRim}" VerticalAlignment="Center">
              <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource LedOff}"/>
                <Style.Triggers><DataTrigger Binding="{Binding ErrOn}" Value="True"><Setter Property="Fill" Value="{DynamicResource LedErr}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
            </Ellipse>
            <TextBlock Text="ERR" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
          </StackPanel>
        </StackPanel>
        <WrapPanel>
          <Image Source="{Binding HeaderIconUri}" Width="30" Height="30" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="OBDLink Diag (Ford-only)"/>
          <TextBlock Text="OBDLink Diag" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{DynamicResource HeaderFg}"/>
          <ComboBox MinWidth="250" MaxDropDownHeight="400" ToolTip="{Binding SelectedPort}" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"/>
          <Button Command="{Binding RefreshPortsCommand}" ToolTip="Rescan COM ports" Padding="6,4"><TextBlock Style="{StaticResource GlyphStyle}" Margin="0" Text="&#xE72C;"/></Button>
          <TextBox Width="62" Text="{Binding ManualPort, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" ToolTip="Type a COM port by hand (e.g. COM4, see Device Manager &gt; Ports (COM &amp; LPT)), then click Use"/>
          <Button Command="{Binding UseManualPortCommand}" Content="Use" ToolTip="Use the typed COM port"/>
          <ComboBox Width="210" ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}" ToolTip="Vehicle profile"/>
          <Button Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryStyle}" ToolTip="Connect (F5)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE703;"/><TextBlock Text="Connect"/></StackPanel></Button>
          <Button Command="{Binding IdentifyVehicleCommand}" Style="{StaticResource PrimaryStyle}" ToolTip="Identify vehicle: read VIN, scan modules, pick the profile (Ctrl+I)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE804;"/><TextBlock Text="Identify vehicle"/></StackPanel></Button>
          <Button Command="{Binding DisconnectCommand}" ToolTip="Disconnect (Shift+F5)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE711;"/><TextBlock Text="Disconnect"/></StackPanel></Button>
          <Border ToolTip="{Binding Status}" MaxWidth="330">
            <Border.Style>
