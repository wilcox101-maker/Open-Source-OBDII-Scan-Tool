                <DataGrid Grid.Row="0" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" FontFamily="{StaticResource Mono}" HeadersVisibility="Column">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Plot" Width="40">
                      <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Plot, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" ToolTip="Show this signal in the chart (up to 8)"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
