                    <Button Command="{Binding ClearChartCommand}" Content="Clear chart" Margin="0,0,12,0"/>
                    <TextBlock Text="Trigger" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="Marks the chart and logs a line when a signal crosses a threshold. Examples: rpm &gt; 3000, ect &lt; 70 hys 2"/>
                    <TextBox Width="150" Text="{Binding TriggerText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" ToolTip="key &gt; value  or  key &lt; value [hys n]"/>
                    <Button Command="{Binding AddTriggerCommand}" Content="Add" Margin="4,0,4,0"/>
