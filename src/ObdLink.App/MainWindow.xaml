                <Button Command="{Binding Routines.ResultsCommand}" Margin="0,0,4,0" ToolTip="31 03: read the routine's status/results"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE9D9;"/><TextBlock Text="Results"/></StackPanel></Button>
