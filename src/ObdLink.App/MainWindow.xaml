<Window x:Class="ObdLink.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OBDLink EX / MX+ Diagnostics (open source)" Height="760" Width="1200">
  <DockPanel Margin="6">
    <!-- Connect panel -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="6" Margin="0,0,0,6">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Port:" VerticalAlignment="Center" Margin="3"/>
        <ComboBox Width="300" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"/>
        <Button Content="Refresh" Command="{Binding RefreshPortsCommand}"/>
        <TextBlock Text="Vehicle:" VerticalAlignment="Center" Margin="12,3,3,3"/>
        <ComboBox Width="190" ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}"/>
        <Button Content="Connect" Command="{Binding ConnectCommand}"/>
        <Button Content="Disconnect" Command="{Binding DisconnectCommand}"/>
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,3"/>
        <TextBlock Text="{Binding Voltage, StringFormat=Battery: {0}}" VerticalAlignment="Center" Margin="12,3"/>
        <TextBlock Text="{Binding AdapterName, StringFormat=Adapter: {0}}" VerticalAlignment="Center" Margin="12,3" FontWeight="Bold"/>
        <TextBlock Text="{Binding Capabilities}" VerticalAlignment="Center" Margin="6,3" ToolTip="Adapter capabilities from the detected profile"/>
        <TextBlock Text="{Binding Baud}" VerticalAlignment="Center" Margin="6,3"/>
      </StackPanel>
    </Border>
    <!-- Log -->
    <ListBox DockPanel.Dock="Bottom" Height="140" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="11"/>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <!-- Module list -->
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FFF4E5" Padding="4">
          <StackPanel>
            <TextBlock Text="{Binding ModeBanner}" FontWeight="Bold" Foreground="DarkRed"/>
            <CheckBox Content="Read-only test mode (Settings)" IsChecked="{Binding ReadOnlyTestMode}"/>
          </StackPanel>
        </Border>
        <Button DockPanel.Dock="Top" Content="Scan modules" Command="{Binding ScanCommand}"/>
        <Button DockPanel.Dock="Top" Content="Diagnostics capture (save zip)" FontWeight="Bold" Command="{Binding DiagnosticsCaptureCommand}"/>
        <Expander DockPanel.Dock="Top" Header="Discovery sweep (UNVERIFIED IDs)">
          <StackPanel Margin="4">
            <StackPanel Orientation="Horizontal"><TextBlock Text="From 0x" VerticalAlignment="Center"/><TextBox Width="45" Text="{Binding DiscoveryStart, UpdateSourceTrigger=LostFocus}"/>
              <TextBlock Text=" to 0x" VerticalAlignment="Center"/><TextBox Width="45" Text="{Binding DiscoveryEnd, UpdateSourceTrigger=LostFocus}"/></StackPanel>
            <CheckBox Content="3E 00 TesterPresent" IsChecked="{Binding DiscoveryTesterPresent}"/>
            <CheckBox Content="22 F1 90 read VIN" IsChecked="{Binding DiscoveryF190}"/>
            <CheckBox Content="KWP 1A 87 ReadEcuId" IsChecked="{Binding DiscoveryKwp1A}"/>
            <CheckBox Content="Include sweep in Diagnostics capture" IsChecked="{Binding CaptureIncludesDiscovery}"/>
            <Button Content="Run discovery sweep" Command="{Binding DiscoveryCommand}"/>
          </StackPanel>
        </Expander>
        <DataGrid ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Mod" Binding="{Binding Acronym}"/>
            <DataGridTextColumn Header="Addr" Binding="{Binding Address}"/>
            <DataGridTextColumn Header="Bus" Binding="{Binding Bus}"/>
            <DataGridTextColumn Header="Found" Binding="{Binding Found}"/>
            <DataGridTextColumn Header="Conf." Binding="{Binding Confidence}"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
      <TabControl Grid.Column="2">
        <TabItem Header="DTCs">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
              <Button Content="Read OBD-II DTCs (03)" Command="{Binding ReadObdDtcsCommand}"/>
              <Button Content="Read module DTCs (19 02)" Command="{Binding ReadModuleDtcsCommand}"/>
              <Button Content="Clear module DTCs (14)…" Command="{Binding ClearModuleDtcsCommand}"/>
              <Button Content="Read VIN (09 02)" Command="{Binding ReadVinCommand}"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Dtcs}" AutoGenerateColumns="True" IsReadOnly="True"/>
          </DockPanel>
        </TabItem>
        <TabItem Header="As-Built (raw)">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
              <TextBlock Text="Block:" VerticalAlignment="Center" Margin="3"/>
              <TextBox Width="40" Text="{Binding AsBuiltBlockNo}"/>
              <Button Content="Read" Command="{Binding ReadAsBuiltCommand}"/>
              <Button Content="Backup" Command="{Binding BackupAsBuiltCommand}"/>
              <Button Content="Write + verify…" Command="{Binding WriteAsBuiltCommand}"/>
              <Button Content="Restore from backup…" Command="{Binding RestoreAsBuiltCommand}"/>
              <Button Content="Import factory .ab…" Command="{Binding ImportFactoryAbCommand}" Margin="12,0,0,0"/>
              <Button Content="Export .ab…" Command="{Binding ExportFactoryAbCommand}"/>
              <Button Content="Compare to factory" Command="{Binding CompareToFactoryCommand}"/>
              <Button Content="Import .abt…" Command="{Binding ImportAbtCommand}" Margin="12,0,0,0"/>
              <Button Content="Export .abt…" Command="{Binding ExportAbtCommand}"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Margin="3" Text="{Binding FactoryInfo}"/>
            <DataGrid DockPanel.Dock="Bottom" Height="180" ItemsSource="{Binding FactoryDiff}" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Address" Binding="{Binding Address}"/>
                <DataGridTextColumn Header="Factory (.ab)" Binding="{Binding Factory}" Width="*"/>
                <DataGridTextColumn Header="Current (module)" Binding="{Binding Current}" Width="*"/>
                <DataGridTextColumn Header="Diff" Binding="{Binding Kind}"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock DockPanel.Dock="Bottom" Margin="3" TextWrapping="Wrap" Foreground="#E0B050"
                       Text="Edit the Data column (hex, without checksum). Checksums are recomputed. Block→DID mapping (DE00+n-1) is UNVERIFIED community convention."/>
            <DataGrid ItemsSource="{Binding AsBuiltRows}" AutoGenerateColumns="False" CanUserAddRows="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Data (hex)" Binding="{Binding Data, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Checksum" Binding="{Binding Checksum}" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem Header="Console">
          <DockPanel>
            <DockPanel DockPanel.Dock="Bottom">
              <CheckBox DockPanel.Dock="Right" Content="Allow writes" Foreground="White" VerticalAlignment="Center" IsChecked="{Binding ConsoleAllowWrites}"/>
              <Button DockPanel.Dock="Right" Content="Send" Command="{Binding ConsoleSendCommand}" IsDefault="True"/>
              <TextBox Text="{Binding ConsoleInput, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
            <TextBox Text="{Binding ConsoleOutput}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
