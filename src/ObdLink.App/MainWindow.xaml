                <Button Command="{Binding Routines.ExtendedSessionCommand}" Margin="0,0,4,0" ToolTip="10 03. Allowed in read-only mode. The app then sends 3E 80 every 2 s so the module stays in it."><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE8AB;"/><TextBlock Text="Extended session (10 03)"/></StackPanel></Button>
                <Button Command="{Binding Routines.DefaultSessionCommand}" Margin="0,0,12,0" ToolTip="10 01: back to the default session (keep-alive stops)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphStyle}" Text="&#xE72B;"/><TextBlock Text="Default session (10 01)"/></StackPanel></Button>
