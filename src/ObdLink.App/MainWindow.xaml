                  <DataGridTextColumn Header="Changed bits" Binding="{Binding Changed}" Width="200"/>
                  <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>
        </TabItem>
        <TabItem Header="Routines" Tag="&#xE945;">
